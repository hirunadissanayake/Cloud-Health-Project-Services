CONFIG_SERVER_URL=http://localhost:8888
EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
PATIENT_DB_URL=jdbc:postgresql://localhost:5432/healthcare_patients
PATIENT_DB_USERNAME=healthcare
PATIENT_DB_PASSWORD=replace-me
PATIENT_DB_POOL_SIZE=10
PATIENT_DB_MIN_IDLE=2
DIAGNOSTICS_MONGODB_URI=mongodb://localhost:27017/healthcare_diagnostics
GCP_PROJECT_ID=replace-with-project-id
MEDICAL_FILES_BUCKET=replace-with-private-bucket-name
FIRESTORE_DATABASE=(default)
FILE_METADATA_COLLECTION=medical_files
SIGNED_URL_SERVICE_ACCOUNT=
SIGNED_URL_MINUTES=15
FILE_MAX_SIZE=25MB
FILE_MAX_SIZE_BYTES=26214400
# Local development only. Prefer the VM service account on Google Cloud.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
HEALTHCARE_LOG_DIR=/var/log/cloud-health
